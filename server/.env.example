# ── Nirolax API ── copy to .env and fill in. .env never goes to git.
# Same variable names as Ruposhi 2.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=

# memory = sample data that resets on restart · mongo = MongoDB Atlas
DATA_SOURCE=memory
MONGODB_URI=
MONGODB_DB=nirolax

# Images (admin uploads go straight from the browser to this folder, as WebP)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nirolax

# Demo: sample staff/clients, OTP is always DEMO_OTP_CODE, demo payment gateway.
DEMO_MODE=true
DEMO_OTP_CODE=222222

# Each 32+ random characters. Required in production.
JWT_SECRET=
JWT_ADMIN_SECRET=
OTP_SECRET=
PAYMENT_SECRET=
WEBHOOK_SECRET=
CUSTOMER_SESSION_DAYS=30
ADMIN_SESSION_HOURS=12

# First owner when the database has no staff yet (used when DEMO_MODE=false)
ATELIER_EMAIL=atelier@nirolax.com
ATELIER_PASSWORD=

# Payments: demo | sslcommerz
PAYMENT_PROVIDER=demo
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true

# Optional: SMS gateway (BulkSMSBD-style) and email (e.g. Brevo SMTP).
# Without them, every SMS and email is written to the console's Outbox.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nirolax <atelier@nirolax.com>
